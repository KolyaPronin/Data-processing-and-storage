      "roundness": null,
      "seed": 111110022,
      "version": 58,
      "versionNonce": 2087368705,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1773634162331,
      "link": null,
      "locked": false,
      "text": "Альтернативы",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Альтернативы",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IDs0alX_EJYWxRxJbZKoF",
      "type": "text",
      "x": 136.4349518368429,
      "y": 555.462301839358,
      "width": 704.7794189453125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1432821658,
      "version": 506,
      "versionNonce": 1589478543,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1773634162331,
      "link": null,
      "locked": false,
      "text": "1) Можно взять React SPA, но нет оптимизации изображений из коробки\n2) Nuxt.js аналогичен Next.js, но требует знаний Vue\n3) Axios удобнее для обработок ошибок,\nчем fetch\n4) MobX у него больше бандл, RTK стандарт \nдля большинства проектов\n5) Chance.js ограничен в возможностях генерации,\nFaker.js дает больше свободы\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Можно взять React SPA, но нет оптимизации изображений из коробки\n2) Nuxt.js аналогичен Next.js, но требует знаний Vue\n3) Axios удобнее для обработок ошибок,\nчем fetch\n4) MobX у него больше бандл, RTK стандарт \nдля большинства проектов\n5) Chance.js ограничен в возможностях генерации,\nFaker.js дает больше свободы\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
