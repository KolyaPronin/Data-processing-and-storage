      "updated": 1773634162331,
      "link": null,
      "locked": false,
      "text": "Протоколы:\n* HTTP/HTTPS - получение \nданных\n* Local Storage API -\nхранение сесси пользователя",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Протоколы:\n* HTTP/HTTPS - получение \nданных\n* Local Storage API -\nхранение сесси пользователя",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "du40aAlTaJVsF29oIlskv",
      "type": "text",
      "x": 137.52905414599604,
      "y": 518.2240403886649,
      "width": 132.0798797607422,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
